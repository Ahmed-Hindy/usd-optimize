#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 0.01
    upAxis = "Z"
)

def Xform "root"
{
    def Mesh "enclosure" (
        active = true
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
        point3f[] points = [(-10, -10, -10), (10, -10, -10), (-10, 10, -10), (10, 10, -10), (-10, -10, 10), (10, -10, 10), (-10, 10, 10), (10, 10, 10)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "hidden"
    {
        def Mesh "hidden" (
            active = true
        )
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
            point3f[] points = [(-2, -2, -2), (2, -2, -2), (-2, 2, -2), (2, 2, -2), (-2, -2, 2), (2, -2, 2), (-2, 2, 2), (2, 2, 2)]
            uniform token subdivisionScheme = "none"
        }
    }

    # Degenerate mesh: all points coincident (zero-size 3D bounding box), placed outside the
    # enclosure's bounds so clustered mode isolates it into its own zero-size cluster.
    def Mesh "zeroExtent" (
        active = true
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(50, 50, 50), (50, 50, 50), (50, 50, 50)]
        uniform token subdivisionScheme = "none"
    }
}

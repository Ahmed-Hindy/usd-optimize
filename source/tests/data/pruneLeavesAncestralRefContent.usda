#usda 1.0

def Xform "Root"
{
    # A grouping prim with real (non-grouping) content. When referenced, prims at and below "Sub"
    # carry an ANCESTRAL reference arc (introduced by the referencing prim), not a direct one.
    def Xform "Sub"
    {
        def Cube "RealCube"
        {
            float3[] extent = [(-5, -5, -5), (5, 5, 5)]
            double size = 10
        }
    }
}

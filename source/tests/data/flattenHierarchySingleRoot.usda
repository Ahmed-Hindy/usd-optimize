#usda 1.0
(
    defaultPrim = "RootAsset"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "RootAsset"
{
    def Xform "Wrapper"
    {
        double3 xformOp:translate = (0, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Geo"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }
    }
}

#usda 1.0

def Xform "World"
{
    # This prim authors a "references" field (a delete of a reference that was never added), so it has
    # authored references metadata, but no reference arc actually composes in. It must therefore be treated
    # as a normal prim, NOT atomically as a reference: its inner empty leaf should be pruned while its real
    # child is kept. The cheaper HasAuthoredReferences() check would misclassify this and preserve the whole
    # subtree, so this fixture guards that distinction.
    def Xform "EmptyRefMixed" (
        delete references = </World/__NoSuchTarget__>
    )
    {
        def Xform "InnerEmpty"
        {
        }

        def Cube "RealCube"
        {
            float3[] extent = [(-5, -5, -5), (5, 5, 5)]
            double size = 10
        }
    }
}
